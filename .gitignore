# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Build and packaging artifacts
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Test and tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Jupyter
.ipynb_checkpoints/

# Sphinx documentation build outputs
docs/build/
docs/html/

# IDE/editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Runtime outputs and logs
*.log
.Rhistory

# Local config overrides (keep tracked templates in option_files)
option_files/*_local.json

# Common workflow output folders if runs are made inside repo
inputs/
outputs/
